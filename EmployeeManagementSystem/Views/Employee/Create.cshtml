@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow p-4">

                <h2 class="text-center text-primary mb-4">
                    Create New Employee
                </h2>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Designation" class="form-label"></label>
                        <input asp-for="Designation" class="form-control" placeholder="Enter Designation" />
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label"></label>
                        <input asp-for="Salary" class="form-control"
                               type="number" placeholder="Enter Salary" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>


                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary">
                            Save Employee
                        </button>
                    </div>


                    <div class="text-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            Back to List
                        </a>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}